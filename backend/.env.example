# Copy settings into backend/.env. Never commit real credentials.
OPENAI_API_KEY=

# Cost-aware model routing.
# Mechanical calls (extraction, grounding, guardrails, question wording, audits).
OPENAI_FAST_MODEL=gpt-4.1-mini
# High-value reasoning calls only (discovery planner + final prose by default).
OPENAI_REASONING_MODEL=gpt-5.6-sol
OPENAI_REASONING_CALLS=discovery_threads.plan,pm_compile.prose
# Optional emergency/testing override. When set, EVERY call uses this model.
# OPENAI_FORCE_MODEL=gpt-4.1-mini

OPENAI_TIMEOUT_SECONDS=60
# GPT-5.6 reasoning effort for reasoning-routed calls.
OPENAI_REASONING_EFFORT=medium
# Transport retries only; graph-level repair/guardrail retries remain unchanged.
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BASE_SECONDS=1
# Temporary 429s use a slower backoff than connection failures.
OPENAI_RATE_LIMIT_RETRY_BASE_SECONDS=10
# Optional directory for durable interview state (contains conversation data).
# ARCHITECT_SESSION_DIR=C:/path/to/private/interview-sessions
# Optional directory for append-only terminal-style diagnostic logs.
# Defaults to backend/logs/sessions.
# ARCHITECT_LOG_DIR=C:/path/to/private/architect-logs
# Optional standard USD rates per million tokens, keyed by exact model/snapshot.
# OPENAI_PRICING_JSON={"your-model":{"input":0.40,"cached_input":0.10,"output":1.60}}

# Comma-separated browser origins when React calls FastAPI directly instead of
# using the Vite /api proxy. localhost:5173 is allowed by default.
# ARCHITECT_FRONTEND_ORIGINS=http://localhost:5173
