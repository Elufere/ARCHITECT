# Copy settings into backend/.env. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60
# Transport retries only; graph-level repair/guardrail retries remain unchanged.
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BASE_SECONDS=1
# Optional directory for durable interview state (contains conversation data).
# ARCHITECT_SESSION_DIR=C:/path/to/private/interview-sessions
# Optional standard USD rates per million tokens, keyed by exact model/snapshot.
# OPENAI_PRICING_JSON={"your-model":{"input":0.40,"cached_input":0.10,"output":1.60}}

# Optional directory for the clean Adaptive PM v2 durable sessions.
# ADAPTIVE_PM_SESSION_DIR=C:/path/to/private/adaptive-pm-sessions
