# Live FastAPI is the default. Leave VITE_API_URL blank in local development
# so Vite proxies /api to ARCHITECT_API_PROXY_TARGET.
VITE_USE_MOCK_API=false
VITE_API_URL=

# Used by vite.config.ts only; not exposed to browser code.
ARCHITECT_API_PROXY_TARGET=http://localhost:8000

# Optional: set VITE_USE_MOCK_API=true to run the old local UI seed service
# without starting FastAPI.
